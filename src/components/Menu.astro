---
import { Image } from 'astro:assets';
import { menu } from '../data/site';
import menuImg from '../assets/menu.jpg';
---

<section id="menu" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="font-display text-3xl font-bold sm:text-4xl">Меню</h2>
    <p class="mt-4 text-lg text-muted">Любой напиток можно сделать на альтернативном молоке — бесплатно.</p>
  </div>

  <Image
    src={menuImg}
    alt="Капучино с латте-артом и круассан на деревянном столе"
    widths={[480, 720, 960, 1200, 1600]}
    sizes="(min-width: 1152px) 1104px, 100vw"
    class="mt-12 h-56 w-full rounded-3xl object-cover sm:h-72"
  />

  <div class="mt-6 grid gap-6 md:grid-cols-3">
    {menu.map((group) => (
      <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <h3 class="font-display text-2xl font-bold text-primary">{group.category}</h3>
        <ul class="mt-6 space-y-4">
          {group.items.map((item) => (
            <li class="flex items-baseline gap-3">
              <div class="min-w-0">
                <p class="font-semibold">{item.name}</p>
                <p class="text-sm text-muted">{item.note}</p>
              </div>
              <span class="flex-1 translate-y-[-4px] border-b border-dotted border-line" aria-hidden="true"></span>
              <p class="font-semibold whitespace-nowrap">{item.price} ₽</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
