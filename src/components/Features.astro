---
const features = [
  {
    title: 'Своя обжарка',
    text: 'Каждую неделю обжариваем свежие зёрна из Эфиопии, Колумбии и Бразилии.',
    icon: '<path d="M12 3c-4 3-6 7-6 10a6 6 0 0 0 12 0c0-3-2-7-6-10z"/><path d="M12 8c-1.5 2-1.5 6 0 9"/>',
  },
  {
    title: 'Бариста с опытом',
    text: 'Наша команда — призёры городских чемпионатов по латте-арту.',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/>',
  },
  {
    title: 'Домашние десерты',
    text: 'Печём каждое утро на своей кухне, без полуфабрикатов.',
    icon: '<path d="M4 15h16v5H4z"/><path d="M6 15v-3a6 6 0 0 1 12 0v3"/><path d="M12 3v3"/>',
  },
  {
    title: 'Можно поработать',
    text: 'Быстрый Wi-Fi, розетки у каждого столика и тихая музыка.',
    icon: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M2 20h20"/>',
  },
];
---

<section class="border-y border-line bg-surface">
  <ul class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    {features.map((f) => (
      <li>
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-cream text-primary">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
        </div>
        <h2 class="text-lg font-semibold">{f.title}</h2>
        <p class="mt-2 leading-relaxed text-muted">{f.text}</p>
      </li>
    ))}
  </ul>
</section>
