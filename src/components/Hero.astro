---
import { site } from '../data/site';
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-cream px-4 py-1.5 text-sm font-semibold text-primary">
        {site.tagline} · с 2019 года
      </p>
      <h1 class="font-display text-4xl leading-tight font-bold text-balance sm:text-5xl lg:text-6xl">
        Кофе, ради которого стоит проснуться пораньше
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
        Обжариваем зёрна сами каждую неделю, печём десерты на своей кухне и варим кофе так, как вы любите.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#booking"
          class="rounded-full bg-primary px-7 py-3.5 text-center font-semibold text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary-hover"
        >
          Забронировать стол
        </a>
        <a
          href="#menu"
          class="rounded-full border border-primary/30 px-7 py-3.5 text-center font-semibold text-primary transition-colors hover:bg-cream"
        >
          Посмотреть меню
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-muted">
        <li class="flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-accent" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <span><span class="sr-only">Часы работы: </span>{site.hours.map((h) => `${h.days} ${h.time}`).join(' · ')}</span>
        </li>
        <li class="flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-accent" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
          <span><span class="sr-only">Адрес: </span>{site.address}</span>
        </li>
      </ul>
    </div>

    <!-- Иллюстрация: чашка кофе с паром -->
    <div class="relative mx-auto w-full max-w-md">
      <div class="absolute inset-0 -z-10 scale-110 rounded-full bg-cream blur-2xl"></div>
      <svg viewBox="0 0 400 400" class="w-full" role="img" aria-label="Чашка капучино с латте-артом">
        <g class="steam" fill="none" stroke="#b45309" stroke-width="6" stroke-linecap="round" opacity="0.35">
          <path d="M160 110c-15-20 15-35 0-60" />
          <path d="M200 100c-15-20 15-35 0-60" />
          <path d="M240 110c-15-20 15-35 0-60" />
        </g>
        <ellipse cx="200" cy="330" rx="150" ry="28" fill="#eadbc0" />
        <ellipse cx="200" cy="322" rx="120" ry="20" fill="#fff" />
        <path d="M90 170h220l-20 130a30 30 0 0 1-30 25H140a30 30 0 0 1-30-25z" fill="#fff" stroke="#eadbc0" stroke-width="4" />
        <path d="M308 195c45 0 45 70 0 70" fill="none" stroke="#fff" stroke-width="18" stroke-linecap="round" />
        <path d="M308 195c45 0 45 70 0 70" fill="none" stroke="#eadbc0" stroke-width="4" stroke-linecap="round" />
        <ellipse cx="200" cy="172" rx="110" ry="24" fill="#92400e" />
        <ellipse cx="200" cy="172" rx="96" ry="18" fill="#c27a3c" />
        <path d="M200 160c-22 0-30 14-14 18 10 3 20 3 28 0 16-4 8-18-14-18z" fill="#fef3c7" />
        <path d="M200 162v14" stroke="#c27a3c" stroke-width="3" stroke-linecap="round" />
      </svg>
    </div>
  </div>
</section>

<style>
  .steam path {
    animation: rise 3s ease-in-out infinite;
  }
  .steam path:nth-child(2) {
    animation-delay: 0.6s;
  }
  .steam path:nth-child(3) {
    animation-delay: 1.2s;
  }
  @keyframes rise {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.2;
    }
    50% {
      transform: translateY(-10px);
      opacity: 1;
    }
  }
</style>
