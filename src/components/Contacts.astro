---
import { site } from '../data/site';
---

<section id="contacts" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="grid gap-6 md:grid-cols-3">
    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Адрес</h3>
      <p class="mt-3 text-lg font-semibold">{site.city}, {site.address}</p>
      <p class="mt-1 text-muted">5 минут пешком от метро</p>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Часы работы</h3>
      <ul class="mt-3 space-y-1 text-lg">
        {site.hours.map((h) => (
          <li><span class="font-semibold">{h.days}</span> {h.time}</li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Связаться</h3>
      <a href={site.phoneHref} class="mt-3 block text-lg font-semibold text-primary hover:underline">{site.phone}</a>
      <a href={site.telegram} class="mt-1 inline-block text-muted hover:text-primary" target="_blank" rel="noopener">Написать в Telegram</a>
    </div>
  </div>
</section>
