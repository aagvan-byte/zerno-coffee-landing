---
import { reviews } from '../data/site';
---

<section id="reviews" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 class="text-center font-display text-3xl font-bold sm:text-4xl">Что говорят гости</h2>

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {reviews.map((r) => (
      <li class="flex flex-col rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <div class="flex gap-1 text-accent" role="img" aria-label="Оценка 5 из 5">
          {Array.from({ length: 5 }).map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21l1.4-7L2 9.3l7-.8z" />
            </svg>
          ))}
        </div>
        <blockquote class="mt-4 flex-1 leading-relaxed">«{r.text}»</blockquote>
        <p class="mt-6 font-semibold text-primary">{r.name}</p>
      </li>
    ))}
  </ul>
</section>
